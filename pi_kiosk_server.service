[Unit]
Description=ICF Church Screen & Pi Canva Control Server (Web UI + HDMI-CEC Scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=teofilwetzel
WorkingDirectory=/home/teofilwetzel/Pi-Canva-Viewer
ExecStart=/usr/bin/python3 /home/teofilwetzel/Pi-Canva-Viewer/app.py --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
