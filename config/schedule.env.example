# Pi-Screen · HDMI-CEC-Zeitplan
# Ziel auf dem Pi: ~/.config/pi-screen/schedule.env
# Nach Änderung anwenden: ~/pi-screen/scripts/apply-schedule.sh

# Uhrzeiten HH:MM (Systemzeit des Pi, Europe/Berlin). Leer = Eintrag aus.
TV_ON=07:30
TV_OFF=20:17

# Wochentage im cron-Format: * = täglich, 1-5 = Mo–Fr, 0,6 = So+Sa
# 1-5: Fr-Abend aus, Sa/So kein Einschalten, Mo früh wieder an
TV_DAYS=1-5
