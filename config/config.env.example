# Pi-Screen V1 configuration
# Installed configuration: /etc/pi-screen/config.env
# After changing the installed file: sudo systemctl restart lightdm

# `canva` opens the presentation fullscreen; `dashboard` opens the public
# church dashboard. `public` is Canva-only and deliberately never opens a
# dashboard or administration surface.
MODE="canva"
CANVA_URL="https://www.canva.com/design/<ID>/view"

# Canva presentation startup. Coordinates are pixels for the attached display.
# Leave CANVA_AUTOPLAY_CLICKS empty to disable the fragile UI automation.
CANVA_LOAD_WAIT_SEC="25"
CANVA_PRESENT_SHORTCUT="ctrl+alt+p"
CANVA_AUTOPLAY_CLICKS="1820,1050;1559,872;0,0"

# HDMI-CEC: normally the connected TV is logical address 0.
CEC_ADDRESS="0"
CEC_WAKE_ON_BOOT="true"

# Dashboard – public read-only screen, no PIN or admin interaction in V1.
DASHBOARD_CHURCH_NAME="ICF Heilbronn"
DASHBOARD_CALENDAR_URL=""
DASHBOARD_VERSE_TEXT="Gott ist unsere Zuflucht und Stärke."
DASHBOARD_VERSE_REFERENCE="Psalm 46,2"
DASHBOARD_WEATHER_LAT="49.1427"
DASHBOARD_WEATHER_LON="9.2109"
DASHBOARD_WEATHER_LOCATION="Heilbronn"
DASHBOARD_BACKGROUND_URL=""
DASHBOARD_LOGO_URL=""

# Reserved for V2 keyboard PIN protection; unused in V1.
ADMIN_PIN="1234"
