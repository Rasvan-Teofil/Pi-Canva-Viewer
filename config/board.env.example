# Pi-Screen Board · Stufe 1
# Ziel auf dem Pi: ~/.config/pi-screen/board.env (bleibt bei Updates erhalten)

# Temporäre Testbuttons "TV aus" / "TV an" unten rechts (true/false)
SHOW_TEST_BUTTONS=true

# Port des lokalen Board-Servers (nur 127.0.0.1)
BOARD_PORT=8787

# Logische CEC-Adresse des Fernsehers (meist 0)
CEC_ADDRESS=0
# CEC-Gerät für den Fallback mit cec-ctl (Pi 4/5: HDMI0 = /dev/cec0)
CEC_DEVICE=/dev/cec0

# ---- Stufe 2: Canva-Diashow (Pfeiltaste links/rechts wechselt die Ansicht) ----
# Canva-Link (edit-, view- oder embed-Link geht). Design muss öffentlich/eingebettet freigegeben sein.
CANVA_URL=https://www.canva.com/design/DAGeJOlW_fg/dcvDxGynTmQVinQOyVVR2Q/view
# Sekunden pro Folie
CANVA_SLIDE_SECONDS=10
# Seitenzahl; 0 = automatisch erkennen
CANVA_PAGES=0
# Canva alle X Minuten neu laden (holt Änderungen am Design)
CANVA_RELOAD_MINUTES=30
# Ansicht beim Start: board oder canva
START_VIEW=board

# ---- Looker Studio (dritte Ansicht) ----
# Report-Link (reporting-, embed- oder datastudio-Link geht). Leer = Ansicht entfällt.
LOOKER_URL=https://lookerstudio.google.com/reporting/13df4065-3f91-4afa-ac5a-b8bd0932a8d9
# Seiten-IDs zum Durchblättern (aus der URL …/page/<ID>), kommagetrennt. Leer = nur erste Seite.
LOOKER_PAGES=p_l7blv2h8fd,QCnqD,p_4jqetcrhqd,p_6y822c2hqd
# Sekunden pro Looker-Seite
LOOKER_PAGE_SECONDS=30
# Bericht alle X Minuten neu laden (nur bei einer Seite relevant)
LOOKER_RELOAD_MINUTES=10

# Reihenfolge der Ansichten (Pfeiltasten), Ansichten ohne URL werden übersprungen
VIEWS=board,canva,looker

# ---- Vers des Tages ----
# youversion = täglicher YouVersion-Vers (wie bible.com/de), local = nur board/verses.js
VERSE_SOURCE=youversion
# YouVersion-Bibelversion: 73 = Hoffnung für alle (Standard auf bible.com/de), 157 = Schlachter 2000,
# 51 = Luther 1912, 3100 = luther.heute, 108 = NGÜ (nur NT + Psalmen). Luther 2017 gibt es dort nicht.
YOUVERSION_VERSION=73
# Kürzel hinter der Bibelstelle; leer = automatisch (73 -> HFA)
YOUVERSION_VERSION_LABEL=
# Optional: App-Key der offiziellen YouVersion Platform API (platform.youversion.com). Leer = öffentliche App-API ohne Key.
YOUVERSION_APP_KEY=
